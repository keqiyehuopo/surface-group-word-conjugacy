           RowBox[{"mn", ",", "mz"}], "}"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "Is tt of the form (b_1 b_2 ... b_{2g-1})?", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"t", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
