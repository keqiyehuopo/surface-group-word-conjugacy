           RowBox[{"i", ",", 
            RowBox[{"2", "*", "mg"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"t", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
